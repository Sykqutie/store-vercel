# Postgres connection string (Neon, Supabase, Vercel Postgres, or any Postgres).
# The Neon integration in Vercel sets DATABASE_URL for you.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign login cookies. Use 32+ random characters:
#   openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Optional
STORE_NAME=SmartMart
STORE_TZ=Asia/Manila

# Backups (local store server only; ignored on Vercel where files are ephemeral)
# BACKUP_DIR=C:\SmartMart\backups
# BACKUP_AUTO=off          # off | daily | weekly — auto-backup while the server runs
# BACKUP_KEEP_DAILY=7      # how many daily backups to keep
# BACKUP_KEEP_WEEKLY=4     # how many weekly backups to keep
