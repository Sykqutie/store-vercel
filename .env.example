# ---------------------------------------------------------------------------
# SmartMart POS - local development environment
# Copy to .env and fill in the values. .env is git-ignored; never commit it.
# ---------------------------------------------------------------------------

# --- Database (Supabase PostgreSQL) ---------------------------------------
# Supabase Dashboard -> Connect -> Connection string -> URI (Session pooler)
# Copy it and replace the placeholders. Keep the password percent-encoded
# (e.g. @ -> %40) or the URL will be mis-parsed by some tools.
#
# Session pooler (port 5432) - RECOMMENDED for this app:
#   postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# Direct connection (port 5432, IPv6 only) - use for schema work/migrations:
#   postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
#
# Transaction pooler (port 6543) - NOT used here: this app runs multi-statement
# transactions and prepared statements, which the transaction pooler breaks.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Root CA for the TLS connection (Supabase issues its own private CA).
# Keep the bundled certs/supabase-root-ca.pem in the repo; it is a public
# certificate, not a secret. To use a different file, set:
# SUPABASE_CA_CERT_PATH=C:\path\to\supabase-root-ca.pem

# --- Auth ------------------------------------------------------------------
# Signs the login cookie. 16+ characters (32+ recommended).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- Store settings --------------------------------------------------------
STORE_NAME=SmartMart
STORE_TZ=Asia/Manila

# --- Backups (local store server only; ignored on Vercel where files are ephemeral)
# BACKUP_DIR=C:\SmartMart\backups
# BACKUP_AUTO=off          # off | daily | weekly - auto-backup while the server runs
# BACKUP_KEEP_DAILY=7      # how many daily backups to keep
# BACKUP_KEEP_WEEKLY=4     # how many weekly backups to keep

# --- Optional: old Neon database, used only by the one-off merge tool ------
# Never used by the app itself. Leave unset unless you run the merge tool.
# NEON_DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
