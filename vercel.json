{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": { "maxDuration": 15, "includeFiles": "{database,certs}/**" }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/", "destination": "/html/index.html" },
    { "source": "/login", "destination": "/html/login.html" },
    { "source": "/install", "destination": "/html/install.html" },
    { "source": "/dashboard", "destination": "/html/dashboard.html" },
    { "source": "/pos", "destination": "/html/pos.html" },
    { "source": "/cashier", "destination": "/html/pos.html" },
    { "source": "/products", "destination": "/html/products.html" },
    { "source": "/inventory", "destination": "/html/products.html" },
    { "source": "/edit-product", "destination": "/html/edit-product.html" },
    { "source": "/categories", "destination": "/html/categories.html" },
    { "source": "/report", "destination": "/html/report.html" },
    { "source": "/receipt", "destination": "/html/receipt.html" },
    { "source": "/users", "destination": "/html/users.html" },
    { "source": "/backup", "destination": "/html/backup.html" },
    { "source": "/forgot-password", "destination": "/html/forgot-password.html" },
    { "source": "/offline", "destination": "/html/offline.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
